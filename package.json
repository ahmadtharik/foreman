{
  "name": "foreman",
  "version": "0.1.0",
  "private": true,
  "description": "Direct a team of AI agents through plan, build and review, using a ticket board as the shared workspace.",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "check:claude": "node src/scripts/check-claude.ts",
    "setup:labels": "node src/scripts/setup-labels.ts",
    "create-tickets": "node src/scripts/create-tickets.ts",
    "smoke:board": "node src/scripts/smoke-board.ts",
    "runner": "node src/scripts/runner.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
